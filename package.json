{
  "name": "night-shift-attendance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "start:replit": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "replit": "tsx scripts/prepare-db.ts && next dev --hostname 0.0.0.0 --port ${PORT:-3000}",
    "lint": "eslint",
    "test": "tsx --test src/lib/attendance-timezone.test.ts scripts/bootstrap-production.test.ts",
    "bootstrap:production": "tsx scripts/bootstrap-production.ts",
    "db:prepare": "tsx scripts/prepare-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "next": "16.3.5",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.7.5",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
