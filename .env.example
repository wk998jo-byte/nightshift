# Night Shift Attendance — local / Replit environment example
# Copy to .env and .env.local, then replace placeholder secrets.
# Never commit real secret values.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
AUTH_SECRET="replace-with-a-long-random-string"
QR_SECRET="replace-with-another-long-random-string"
NEXT_PUBLIC_APP_NAME="Night Shift Attendance"
APP_TIMEZONE="Asia/Riyadh"

# Destructive local-only reset. Do not use unless you intend to wipe the database.
# RESET_DEMO=1
