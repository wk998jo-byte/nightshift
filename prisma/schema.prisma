generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  SUPERVISOR
  SECURITY
  EMPLOYEE
}

enum AssignmentStatus {
  SCHEDULED
  OFF
  LEAVE
}

enum LeaveType {
  ANNUAL
  SICK
  APPROVED_ABSENCE
}

enum AttendanceMethod {
  QR
  MANUAL
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         Role
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  auditLogs    AuditLog[]
  adjustments  AttendanceAdjustment[]
}

model Employee {
  id              String   @id @default(cuid())
  employeeCode    String   @unique
  badgeNumber     String   @unique
  fullName        String
  mobile          String?
  department      String?
  position        String?
  company         String   @default("Bin Quraya")
  defaultProjectId String?
  defaultProject  Project? @relation("EmployeeDefaultProject", fields: [defaultProjectId], references: [id])
  supervisorId    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  user         User?
  assignments  EmployeeShiftAssignment[]
  attendance   AttendanceRecord[]
  leaves       Leave[]
  devices      Device[]
  supervisedProjects ProjectSupervisor[]
}

model Project {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  locationLabel String?
  latitude      Float
  longitude     Float
  radiusMeters  Int      @default(100)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  employeesDefault Employee[] @relation("EmployeeDefaultProject")
  terminals        QrTerminal[]
  assignments      EmployeeShiftAssignment[]
  attendance       AttendanceRecord[]
  supervisors      ProjectSupervisor[]
}

model ProjectSupervisor {
  id         String   @id @default(cuid())
  projectId  String
  employeeId String
  project    Project  @relation(fields: [projectId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@unique([projectId, employeeId])
}

model Shift {
  id                        String   @id @default(cuid())
  name                      String
  startTime                 String // "18:00"
  endTime                   String // "06:00"
  crossesMidnight           Boolean  @default(true)
  gracePeriodMinutes        Int      @default(5)
  minWorkMinutes            Int?
  overtimeRequiresApproval  Boolean  @default(false)
  checkinWindowBeforeMinutes Int     @default(30)
  checkoutWindowAfterMinutes Int     @default(180)
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())

  assignments EmployeeShiftAssignment[]
  attendance  AttendanceRecord[]
}

model EmployeeShiftAssignment {
  id         String           @id @default(cuid())
  employeeId String
  projectId  String
  shiftId    String
  workDate   String // YYYY-MM-DD = shift start calendar date
  status     AssignmentStatus @default(SCHEDULED)
  leaveType  LeaveType?
  createdAt  DateTime         @default(now())

  employee   Employee           @relation(fields: [employeeId], references: [id])
  project    Project            @relation(fields: [projectId], references: [id])
  shift      Shift              @relation(fields: [shiftId], references: [id])
  attendance AttendanceRecord[]

  @@unique([employeeId, workDate, shiftId])
  @@index([workDate, projectId])
}

model Leave {
  id         String    @id @default(cuid())
  employeeId String
  workDate   String
  type       LeaveType
  status     String    @default("approved")
  note       String?
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId, workDate])
}

model QrTerminal {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  slug            String   @unique
  secretKey       String
  rotationSeconds Int      @default(30)
  isActive        Boolean  @default(true)
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())

  project  Project     @relation(fields: [projectId], references: [id])
  sessions QrSession[]
}

model QrSession {
  id         String    @id @default(cuid())
  terminalId String
  projectId  String
  tokenHash  String    @unique
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  terminal QrTerminal @relation(fields: [terminalId], references: [id])

  @@index([projectId, expiresAt])
}

model AttendanceRecord {
  id                   String  @id @default(cuid())
  employeeId           String
  projectId            String
  shiftId              String
  assignmentId         String?

  scheduledStart       DateTime
  scheduledEnd         DateTime
  checkInAt            DateTime?
  checkOutAt           DateTime?

  checkInLatitude      Float?
  checkInLongitude     Float?
  checkOutLatitude     Float?
  checkOutLongitude    Float?

  checkInMethod        AttendanceMethod?
  checkOutMethod       AttendanceMethod?
  checkInQrSessionId   String?
  checkOutQrSessionId  String?
  checkInDeviceId      String?
  checkOutDeviceId     String?
  checkInIp            String?
  checkOutIp           String?

  workedMinutes        Int?
  lateMinutes          Int     @default(0)
  earlyLeaveMinutes    Int     @default(0)
  overtimeMinutes      Int     @default(0)

  /// JSON array of flags e.g. ["PRESENT","LATE","OVERTIME"]
  flags                String  @default("[]")
  statusPrimary        String  @default("SCHEDULED")
  manualOverride       Boolean @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  employee    Employee                 @relation(fields: [employeeId], references: [id])
  project     Project                  @relation(fields: [projectId], references: [id])
  shift       Shift                    @relation(fields: [shiftId], references: [id])
  assignment  EmployeeShiftAssignment? @relation(fields: [assignmentId], references: [id])
  adjustments AttendanceAdjustment[]

  @@index([employeeId, checkInAt])
  @@index([projectId, scheduledStart])
  @@index([statusPrimary])
}

model AttendanceAdjustment {
  id           String   @id @default(cuid())
  attendanceId String
  field        String
  oldValue     String?
  newValue     String?
  reason       String
  changedById  String
  createdAt    DateTime @default(now())

  attendance AttendanceRecord @relation(fields: [attendanceId], references: [id])
  changedBy  User             @relation(fields: [changedById], references: [id])
}

model Device {
  id                String   @id @default(cuid())
  employeeId        String?
  deviceFingerprint String
  userAgent         String?
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  trustLevel        String   @default("normal")
  flagged           Boolean  @default(false)

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([deviceFingerprint])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  employeeId String?
  oldValue   String?
  newValue   String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([action])
}
